DATABASE_URL=

# Render API configuration
NODE_ENV=production
# Render supplies PORT automatically. Keep it unset locally unless you need a custom port.
PORT=

# The public Vercel URL, used when the API is called directly from a browser.
# For the Vercel rewrite setup, keep the API calls on the relative /api path.
FRONTEND_URL=https://your-frontend.vercel.app

# Optional Web Push configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com