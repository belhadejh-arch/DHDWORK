modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VAPID_PUBLIC_KEY = "BE1FW7wyTolAHwwGujP1g9YUw0CkZcqUDm7xLRaqiZaIR9Vz6mC_BXuY760srhS8hj_Djkfns_QCdpphGMiggbQ"
VAPID_SUBJECT = "mailto:admin@dhd-livraison.dz"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DHD Frontend Preview"

[[workflows.workflow]]
name = "DHD Frontend Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22444 BASE_PATH=/ pnpm --filter @workspace/dhd-livraison run dev -- --host 0.0.0.0"
waitForPort = 22444

[workflows.workflow.metadata]
outputType = "webview"
