modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DHD App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DHD Frontend"

[[workflows.workflow]]
name = "DHD App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c 'fuser -k 8080/tcp 2>/dev/null; PORT=8080 NODE_ENV=production node artifacts/api-server/dist/index.mjs'"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "DHD Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22444 pnpm --filter @workspace/dhd-livraison run dev"
waitForPort = 22444

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
