{
  "name": "dhd-livraison-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/api-server",
    "artifacts/dhd-livraison",
    "lib/*"
  ],
  "scripts": {
    "build:api": "npm run build --workspace=@workspace/api-server",
    "start:api": "npm run start --workspace=@workspace/api-server",
    "build": "npm run build --workspace=@workspace/api-server",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "dev": "tsx server.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
